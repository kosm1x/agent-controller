# v7.7.3 supply-chain defense — refuse npm package versions published
# less than 7 days ago. Defends against fresh-malicious-release attacks
# (event-stream, ua-parser-js, @ctrl/tinycolor pattern) where an attacker
# publishes a compromised version and waits for CI/dev workstations to
# pull it before the malicious code is flagged.
#
# Source: adopted from qwibitai/nanoclaw v1.2.52 (2026-04-14) per
# reference_nanoclaw_upstream.md Tier 1 adoption list.
#
# 2026-09-01 correction (nanoclaw upstream review): npm's key is
# `min-release-age` and its unit is DAYS (npm/cli
# workspaces/config/lib/definitions/definitions.js). The previous
# `minimum-release-age=10080` was never a real npm option — a silent no-op for
# 4.5 months. The option lands in npm 11.10.0 (`min-release-age-exclude` in
# npm 12.0.0); the host's npm 10.9.8 ignores it, so this is inert until the
# operator upgrades npm (`npm install -g npm@12`, node >= 22.22.2 satisfied).
# To pull an urgent fix inside the window: `npm install <pkg>
# --min-release-age=0` on that one command, or (npm >= 12) add the package to
# `min-release-age-exclude` — never globally.
min-release-age=7
