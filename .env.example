# Mission Control - Environment Configuration

# Authentication
MC_API_KEY=change-me-in-production

# Server
MC_PORT=8080
MC_DB_PATH=./data/mc.db

# Primary inference provider (required)
INFERENCE_PRIMARY_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INFERENCE_PRIMARY_KEY=sk-your-key-here
INFERENCE_PRIMARY_MODEL=qwen3-235b-a22b

# Fallback inference provider (optional)
# INFERENCE_FALLBACK_URL=https://api.minimax.chat/v1
# INFERENCE_FALLBACK_KEY=your-fallback-key
# INFERENCE_FALLBACK_MODEL=MiniMax-M1

# Inference settings
INFERENCE_TIMEOUT_MS=30000
INFERENCE_MAX_TOKENS=4096

# Container settings
NANOCLAW_IMAGE=nanoclaw-agent:latest
MAX_CONCURRENT_CONTAINERS=5

# Hindsight recall — gates whether retrieved memories augment LLM prompt.
# Default: false (silent). Disabled 2026-04-25 due to reranker latency.
# Re-enable when p95 recall latency <= 1.5s. See feedback_hindsight_recall_disabled.
HINDSIGHT_RECALL_ENABLED=false

# V9 W1 completion grader (src/lib/v8-4/grade-specs.ts + grader.ts). Default
# off. shadow = grade prose criteria in the background after completion,
# trace-only (gates.graded), never changes status or text. enforce = grade
# onto GR-* ledger rows before the verdict; needs TASK_GATES_MODE=shadow|enforce
# (with the ledger off it resolves to off). Readout: ./mc-ctl gates graded
# TASK_GATES_GRADER=off
# Wall-clock budget per grading call in ms; clamped to [5000, 600000].
# TASK_GATES_GRADER_BUDGET_MS=90000
